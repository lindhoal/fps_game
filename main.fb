Import std.core
Import fbengine
Import std.math

Function Main() Throws GraphicsError
    Window.SetTitle("Hello")
    Try Graphics(800, 600) // opens the window (WINDOWED by default)
    Defer EndGraphics()

    Local canvas = Screen.Canvas()
    Local cubeGeometry: Geometry = Geometry.Cube()
    Local cube: Mesh = Mesh(cubeGeometry)
    cube.SetPosition(Vec3(0, 0, 0))
    cube.SetColor(Color.White)

    While !KeyDown(Key.ESCAPE) && !Window.Closed()
        canvas.SetColor(Color32(255, 255, 255, 255))
        Flip() // present + read events
    End While
End Function

Try Main()
